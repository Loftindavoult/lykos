generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  role         String     @default("staff") // "admin" | "staff"
  passwordHash String
  createdAt    DateTime   @default(now())
  activities   Activity[]
  tasks        Task[]
  connectedSocialAccounts SocialAccount[]
  socialPosts  SocialPost[]
}

model Account {
  id            String     @id @default(cuid())
  companyName   String
  contactName   String?
  email         String?
  phone         String?
  industry      String?
  stage         String     @default("Lead") // Lead | Contacted | Qualified | Proposal | Won | Lost
  source        String     @default("manual") // website | wizard | manual
  value         Int? // deal value in whole dollars
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  activities    Activity[]
  tasks         Task[]
}

model Activity {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String    // Call | Email | Meeting | Note
  text        String
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id])
  createdAt   DateTime  @default(now())
}

model Task {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  text        String
  dueDate     DateTime?
  done        Boolean   @default(false)
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id])
  createdAt   DateTime  @default(now())
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  channel   String   // e.g. website | wizard | facebook | linkedin | referral
  spend     Int?     // whole dollars
  createdAt DateTime @default(now())
}

model SocialAccount {
  id                String    @id @default(cuid())
  platform          String    @unique // "facebook" | "linkedin"
  externalAccountId String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  connectedByStaffId String?
  connectedByStaff  StaffUser? @relation(fields: [connectedByStaffId], references: [id])
  createdAt         DateTime  @default(now())
  posts             SocialPost[]
}

model SocialPost {
  id              String    @id @default(cuid())
  platform        String    // "facebook" | "linkedin"
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  caption         String
  scheduledAt     DateTime
  status          String    @default("draft") // draft | scheduled | posted | failed
  externalPostId  String?
  failureReason   String?
  createdByStaffId String?
  createdByStaff  StaffUser? @relation(fields: [createdByStaffId], references: [id])
  createdAt       DateTime  @default(now())
}
