generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  role         String     @default("staff") // "admin" | "staff"
  passwordHash String
  createdAt    DateTime   @default(now())
  activities   Activity[]
  tasks        Task[]
  connectedSocialAccounts SocialAccount[]
  socialPosts  SocialPost[]
}

model Account {
  id            String     @id @default(cuid())
  companyName   String
  contactName   String?
  email         String?
  phone         String?
  website       String?
  socialUrl     String? // Facebook/Instagram page — whichever the business actually uses
  industry      String?
  stage         String     @default("Lead") // Lead | Opportunity | Build | Approval | Negotiations | Deploy | Active | Inactive
  source        String     @default("manual") // website | wizard | manual
  value         Int? // one-time deal value in whole dollars (legacy; MRR is the primary figure now)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  activities    Activity[]
  tasks         Task[]

  // Set once and never unset the first time stage becomes "Active" — lets
  // "Inactive" (which covers both a deal falling through AND a paying
  // customer churning) be told apart after the fact for win-rate/churn
  // reporting, even though both land on the same terminal stage.
  everActive    Boolean    @default(false)

  // MRR calculator (see lib/pricing.js) — either computed from a package
  // level + user count (+ optional add-ons), or a flat custom override.
  mrr             Int?     // final monthly recurring revenue in whole dollars
  mrrCustom       Boolean  @default(false)
  packageLevel    String?  // key into PACKAGE_LEVELS, null if mrrCustom or unset
  userCount       Int?
  addonInventory  Boolean  @default(false)
  addonConsulting Boolean  @default(false)

  // Which Stripe fee schedule applies (see STRIPE_FEES in lib/pricing.js) —
  // drives the estimated processing-fee/net-MRR figures shown alongside
  // the gross MRR everywhere it's displayed.
  billingMethod   String   @default("card") // "card" | "ach"

  // Which campaign this account is a target of / came from — lets a
  // Campaign hold a real list of named businesses, not just an aggregate
  // channel-string match.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Lead grade (see lib/leadScore.js) — how good a fit this account's
  // industry is for what Lykos actually sells. Computed automatically from
  // `industry` on create/import, but staff can override it by hand.
  leadScore     String? // "A" | "B" | "C" | "D", null = ungraded
  leadScoreAuto Boolean @default(true) // false once a human overrides it
}

model Activity {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String    // Call | Email | Meeting | Note
  text        String
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id])
  createdAt   DateTime  @default(now())
}

model Task {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  text        String
  dueDate     DateTime?
  done        Boolean   @default(false)
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id])
  createdAt   DateTime  @default(now())
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  channel   String    // e.g. website | wizard | facebook | linkedin | referral
  spend     Int?      // whole dollars
  createdAt DateTime  @default(now())
  accounts  Account[] // the real, named target/source list for this campaign
}

model SocialAccount {
  id                String    @id @default(cuid())
  platform          String    @unique // "facebook" | "linkedin"
  externalAccountId String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  connectedByStaffId String?
  connectedByStaff  StaffUser? @relation(fields: [connectedByStaffId], references: [id])
  createdAt         DateTime  @default(now())
  posts             SocialPost[]
}

model SocialPost {
  id              String    @id @default(cuid())
  platform        String    // "facebook" | "linkedin"
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  caption         String
  scheduledAt     DateTime
  status          String    @default("draft") // draft | scheduled | posted | failed
  externalPostId  String?
  failureReason   String?
  createdByStaffId String?
  createdByStaff  StaffUser? @relation(fields: [createdByStaffId], references: [id])
  createdAt       DateTime  @default(now())
}
